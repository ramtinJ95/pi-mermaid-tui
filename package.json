{
  "name": "@ramtinj95/pi-mermaid-tui",
  "version": "0.2.2",
  "description": "Render Mermaid diagrams as terminal-native Unicode directly in the Pi TUI",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ramtin Javanmardi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramtinJ95/pi-mermaid-tui.git"
  },
  "homepage": "https://github.com/ramtinJ95/pi-mermaid-tui#readme",
  "bugs": {
    "url": "https://github.com/ramtinJ95/pi-mermaid-tui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "mermaid",
    "diagram",
    "terminal",
    "tui"
  ],
  "files": [
    "src",
    "test",
    "grok-mermaid/build_wasm.sh",
    "grok-mermaid/Cargo.lock",
    "grok-mermaid/Cargo.toml",
    "grok-mermaid/LICENSE",
    "grok-mermaid/README.md",
    "grok-mermaid/src",
    "grok-mermaid.wasm",
    "licenses",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^24.12.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:update-goldens": "UPDATE_GOLDENS=1 node --test test/terminal-golden.test.ts",
    "test:renderer": "cargo test --locked --manifest-path grok-mermaid/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test:package": "npm pack --dry-run",
    "check": "npm run typecheck && npm test && npm run test:renderer && npm run test:package"
  },
  "publishConfig": {
    "access": "public"
  }
}
